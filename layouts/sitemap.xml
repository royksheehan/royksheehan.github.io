{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ .Site.Home.Permalink }}</loc>
    <changefreq>daily</changefreq>
    <priority>1.00</priority>
  </url>

  {{- range .Site.RegularPages }}
  {{- $safeLastmod := .Lastmod }}
  {{- if $safeLastmod.IsZero }}
    {{- $safeLastmod = .Date }}
  {{- end }}
  {{- if $safeLastmod.IsZero }}
    {{- $safeLastmod = .PublishDate }}
  {{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not $safeLastmod.IsZero }}
    <lastmod>{{ $safeLastmod.Format "2006-01-02" }}</lastmod>
    {{- end }}
    {{- if in .Section "posts" }}
    <changefreq>weekly</changefreq>
    <priority>0.80</priority>
    {{- else }}
    <changefreq>monthly</changefreq>
    <priority>0.60</priority>
    {{- end }}
  </url>
  {{- end }}

  {{- range .Site.Sections }}
  {{- $safeLastmod := .Lastmod }}
  {{- if $safeLastmod.IsZero }}
    {{- $safeLastmod = .Date }}
  {{- end }}
  {{- if $safeLastmod.IsZero }}
    {{- $safeLastmod = .PublishDate }}
  {{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not $safeLastmod.IsZero }}
    <lastmod>{{ $safeLastmod.Format "2006-01-02" }}</lastmod>
    {{- end }}
    <changefreq>weekly</changefreq>
    <priority>0.70</priority>
  </url>
  {{- end }}

  {{- range .Site.Taxonomies.tickers }}
  {{- $safeLastmod := .Page.Lastmod }}
  {{- if $safeLastmod.IsZero }}
    {{- $safeLastmod = .Page.Date }}
  {{- end }}
  {{- if $safeLastmod.IsZero }}
    {{- $safeLastmod = .Page.PublishDate }}
  {{- end }}
  <url>
    <loc>{{ .Page.Permalink }}</loc>
    {{- if not $safeLastmod.IsZero }}
    <lastmod>{{ $safeLastmod.Format "2006-01-02" }}</lastmod>
    {{- end }}
    <changefreq>weekly</changefreq>
    <priority>0.65</priority>
  </url>
  {{- end }}
</urlset>
